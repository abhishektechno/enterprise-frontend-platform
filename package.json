{
  "name": "enterprise-frontend-platform",
  "version": "1.0.0",
  "description": "Production-style enterprise frontend architecture built with React and TypeScript",
  "private": true,
  "license": "ISC",
  "author": "Abhishek Dubey",
  "type": "commonjs",
  "main": "index.js",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter shell dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check"
  },
  "devDependencies": {
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
